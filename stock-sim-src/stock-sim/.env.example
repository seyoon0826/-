# 복사해서 .env 로 사용: cp .env.example .env  (실제 키는 .env 에만, 커밋 금지)
DATABASE_URL=postgresql+psycopg://stock:stock@localhost:5432/stocksim
REDIS_URL=redis://localhost:6379/0
MARKET_PROVIDER=pykrx   # pykrx | replay | kis
REPLAY_SPEED=60
KIS_MAX_SUBSCRIPTIONS=40
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_PAPER=True
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ECOS_API_KEY=
ANTHROPIC_API_KEY=
JWT_SECRET=   # 32바이트 이상 임의 문자열 (예: openssl rand -hex 32). 비어 있으면 모의투자 API 가 401
# pykrx 1.2.9 는 KRX 회원 로그인 필요(없으면 로그인 실패 메시지). TODO(verify)
KRX_ID=
KRX_PW=

# 수집/유니버스 (선택)
UNIVERSE_SIZE=30
UNIVERSE_INCLUDE_PREFERRED=false   # 우선주(삼성전자우 등) 포함 여부
NEWS_INTERVAL_OPEN_MIN=5
NEWS_INTERVAL_CLOSED_MIN=30

# 모의투자 (선택)
PAPER_IGNORE_MARKET_HOURS=false   # 개발용: true 면 장 시간과 무관하게 즉시 체결 판정
PAPER_MAX_ORDER_QTY=100000
MODEL_VERSION=   # 학습 산출물 폴더 이름 (예: lgbm-20261022-xxxxxx). 비우면 예측 없이 기동
LLM_MODEL=       # 시나리오 생성 모델 (오너 지정). 비우거나 ANTHROPIC_API_KEY 가 없으면 템플릿 문장

# AI 계정 규칙 (FR-AI-2)
AI_MODE=rank            # rank: 순위 상위 AI_TOP_N 매수, AI_SELL_RANK 밖이면 매도 | probability: 확률 문턱(SPEC 원안)
AI_TOP_N=5
AI_SELL_RANK=10
AI_BUY_THRESHOLD=0.55   # probability 모드에서만
AI_SELL_THRESHOLD=0.50  # probability 모드에서만

# 인증 (FR-AU)
REFRESH_TOKEN_DAYS=14
LOGIN_RATE_PER_MIN=10
CORS_ORIGINS=http://localhost:3000   # 쉼표 구분. 도메인 연결 시 https://<도메인> 추가
REFRESH_COOKIE_SECURE=false          # HTTPS 로 서비스할 때 true
NEXT_PUBLIC_API_URL=http://localhost:8000   # 프론트 이미지 빌드 인자 (브라우저가 부르는 API 주소)

# 소셜 로그인 (키가 비어 있으면 그 버튼을 감춘다). 콜백 주소: {API_PUBLIC_URL}/api/v1/auth/oauth/{naver|google}/callback
NAVER_LOGIN_CLIENT_ID=      # 네이버 개발자 센터 > 내 애플리케이션 > Client ID (사용 API: 네이버 로그인)
NAVER_LOGIN_CLIENT_SECRET=  # 같은 화면의 Client Secret
GOOGLE_CLIENT_ID=        # Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹)
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
