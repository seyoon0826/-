# 주소 하나로 서비스: https://{SITE_DOMAIN}/api/* -> 백엔드, 나머지 -> 프론트.
# 인증서는 Let's Encrypt 에서 자동으로 받고 갱신한다 (80/443 포트가 열려 있어야 한다).
{$SITE_DOMAIN} {
	encode zstd gzip

	# 백엔드: REST, 소셜 로그인 콜백, 웹소켓(/api/v1/ws/*) 모두 그대로 넘긴다
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
